{
    "manifests": {
        "silarhi/turbo-bundle": {
            "manifest": {
                "bundles": {
                    "Silarhi\\TurboBundle\\SilarhiTurboBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "templates/": "templates/"
                },
                "post-install-output": [
                    "  * Install the JavaScript side: <comment>pnpm add @silarhi/turbo</> (or <comment>php bin/console importmap:require @silarhi/turbo</>)",
