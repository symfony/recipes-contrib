                    "    frame requests then use <comment>templates/base-frame.html.twig</>.",
                    "  * Read the documentation at <comment>https://turbo-bundle.silarhi.dev/</>"
                ]
            },
            "files": {
                "templates/base-frame.html.twig": {
                    "contents": [
                        "<turbo-frame id=\"{{ turbo_frame_id() }}\">",
                        "    {% block body %}{% endblock %}",
                        "</turbo-frame>",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "d9716558f285f73ba8832ba06503640e38bd0d0a"
        }
    }
