{
    "manifests": {
        "soviann/deploy-tasks-bundle": {
            "manifest": {
                "bundles": {
                    "Soviann\\DeployTasksBundle\\SoviannDeployTasksBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "deploy/": "deploy/"
                },
                "copy-from-package": {
                    "bin/deploy-tasks-host.sh.dist": "%BIN_DIR%/deploy-tasks-host.sh"
