                        ""
                    ],
                    "executable": false
                },
                "deploy/host-tasks/.gitignore": {
                    "contents": [
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "a4fd9d706a78ebc8df5a6d0bfda60ab0b8c4d674"
        }
    }
}
