{
    "manifests": {
        "locastic/loggastic": {
            "manifest": {
                "bundles": {
                    "Locastic\\Loggastic\\LocasticLoggasticBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * Add the <comment>#[Loggable(groups: ['your_group'])]</> attribute to an entity",
                    "    and the same serialization group to each field you want to log",
                    "  * Create the activity log tables:",
                    "    <comment>php bin/console locastic:activity-logs:create-loggable-indexes</>",
                    "",
                    "  * Read the documentation at <comment>https://github.com/Locastic/Loggastic</>"
                ]
            },
            "files": {
                "config/packages/loggastic.yaml": {
                    "contents": [
                        "locastic_loggastic:",
                        "    # Where activity logs are stored:",
                        "    #   doctrine      - two tables in the database of the default Doctrine DBAL connection",
                        "    #   elasticsearch - Elasticsearch 8 or 9 (also set elastic_host)",
                        "    #   in_memory     - the PHP process only, for test suites",
                        "    storage: doctrine",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "b9be69bf01d89097edc08fb48852429a480db0c4"
        }
    }
}
