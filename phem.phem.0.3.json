{
    "manifests": {
        "phem/phem": {
            "manifest": {
                "bundles": {
                    "Phem\\PhemBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    ".symfony.local.yaml": ".symfony.local.yaml",
                    "src/": "%SRC_DIR%/"
                },
                "post-install-output": [
                    "  * Start the web server: <comment>symfony serve</>",
                    "    It also runs <comment>vendor/bin/phemc watch src</>, which compiles the <comment>.phem</> files when you save them",
                    "  * Open the URL that it shows: the page of <comment>src/Ui/HomePage.phem</> is at <comment>/</>",
                    "  * Read the guide: <comment>https://phem.dev/getting-started/</>"
                ]
            },
            "files": {
                ".symfony.local.yaml": {
                    "contents": [
                        "workers:",
                        "    # Compiles the .phem files, and compiles them again when you save them.",
                        "    phemc:",
                        "        cmd: ['vendor/bin/phemc', 'watch', 'src']",
                        ""
                    ],
                    "executable": false
                },
                "src/Ui/Common/Document.phem": {
                    "contents": [
                        "<?phem",
                        "",
                        "namespace App\\Ui\\Common;",
                        "",
                        "use Phem\\Attribute\\Component;",
                        "use Phem\\{Html, Node, Root};",
                        "",
                        "// The HTML document of the pages. A page gives its title with <Document:title>.",
                        "#[Component]",
                        "function Document(Html $title, Html $children): Node",
                        "{",
                        "    return (",
                        "        <html lang=\"en\">",
                        "            <head>",
                        "                <meta charset=\"utf-8\" />",
                        "                <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />",
                        "                <title>{{ title }}</title>",
                        "                <link rel=\"icon\" href=\"data:,\" />",
                        "                {{ importmap('app') }}",
                        "            </head>",
                        "            <body>",
                        "                <Root>{{ children }}</Root>",
                        "            </body>",
                        "        </html>",
                        "    );",
                        "}",
                        ""
                    ],
                    "executable": false
                },
                "src/Ui/HomePage.phem": {
                    "contents": [
                        "<?phem",
                        "",
                        "namespace App\\Ui;",
                        "",
                        "use Phem\\Attribute\\Page;",
                        "use Phem\\Node;",
                        "",
                        "use function App\\Ui\\Common\\Document;",
                        "",
                        "#[Page('/')]",
                        "function HomePage(): Node",
                        "{",
                        "    return (",
                        "        <Document>",
                        "            <Document:title>My app</Document:title>",
                        "            <h1>Hello, Phem!</h1>",
                        "        </Document>",
                        "    );",
                        "}",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "7d7b4e81c0da11217e64c5f52ac56f4b7639889f"
        }
    }
}
