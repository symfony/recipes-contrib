# KiwiCaptcha environment placeholders
#
# The recipe's manifest.json declares these values (Flex writes them
# into .env on install). If you apply the template manually, add them
# to your .env yourself.
KIWI_SECRET_KEY=change-me-to-a-random-32-byte-value

# Env-managed credentials: the Redis DSN and the public origin live in
# the environment, never in source-controlled YAML. The bundle
# validates the resolved DSN when the client is constructed (redis://
# or rediss:// with a host, fail-closed). A literal override in
# config/packages/kiwicaptcha.yaml is still possible.
KIWI_REDIS_DSN=redis://127.0.0.1:6379/0
KIWI_PUBLIC_URL=https://captcha.example.com
