{
    "manifests": {
        "acencyril/rehearsal-bundle": {
            "manifest": {
                "bundles": {
                    "Acencyril\\RehearsalBundle\\RehearsalBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * <fg=blue>Rehearsal</>: the section is at <comment>/{_locale}/admin/rehearsal</> (ROLE_ADMIN),",
                    "    behind your firewall. Change the prefix in <comment>config/routes/rehearsal.yaml</>.",
                    "  * Proposed changes are read from <comment>.rehearsal/changes.json</> (see the README for the format).",
                    "  * Hook <comment>Acencyril\\RehearsalBundle\\Event\\ChangeValidated</> to merge and deploy.",
                    ""
                ]
            },
            "files": {
                "config/packages/rehearsal.yaml": {
                    "contents": [
                        "# Rehearsal: try a change in the admin before production.",
                        "# Reference: vendor/acencyril/rehearsal-bundle/README.md",
                        "rehearsal:",
                        "    changes_file: '%kernel.project_dir%/.rehearsal/changes.json'",
                        "    decisions_file: '%kernel.project_dir%/var/rehearsal/decisions.json'",
                        "    validation: manual                          # manual: wait for the click; auto: validate when the tests pass",
                        "    role: ROLE_ADMIN",
                        "    # parent_template: 'admin/layout.html.twig' # your admin layout, with \"title\" and \"body\" blocks",
                        "    mailer:",
                        "        enabled: false                          # a recap on new changes and on each decision",
                        "        # from: 'no-reply@example.com'",
                        "        # to: ['you@example.com']",
                        "        # locale: en",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/rehearsal.yaml": {
                    "contents": [
                        "# The Rehearsal section of the admin. It checks rehearsal.role itself; keep it behind",
                        "# your firewall so that visitors are asked to sign in.",
                        "rehearsal:",
                        "    resource: '@RehearsalBundle/config/routes.php'",
                        "    prefix: '/{_locale}/admin/rehearsal'",
                        "    trailing_slash_on_root: false",
                        "    requirements:",
                        "        _locale: 'en|fr'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "bc81725428e73c79d50c3193b2f968e207c5efd7"
        }
    }
}
