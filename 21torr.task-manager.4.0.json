{
    "manifests": {
        "21torr/task-manager": {
            "manifest": {
                "bundles": {
                    "Torr\\TaskManager\\TaskManagerBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/task_manager.yaml": {
                    "contents": [
                        "task_manager:",
                        "    queues:",
                        "        # queues sorted by priority. Highest priority at the top",
                        "        - app_very_urgent",
                        "        - app_urgent",
                        "        - app",
                        "",
                        "framework:",
                        "    messenger:",
                        "        buses:",
                        "            messenger.bus.default:",
                        "                # The middleware config of a bus isn't merged, so if you configure",
                        "                # additional middleware for this bus, add them here as well.",
                        "                middleware:",
                        "                    - Torr\\TaskManager\\Identification\\TaskIdentificationMiddleware",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "8a1e4374773024e8909b0b815b839938bf472281"
        }
    }
}
