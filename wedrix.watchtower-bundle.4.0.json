{
    "manifests": {
        "wedrix/watchtower-bundle": {
            "manifest": {
                "bundles": {
                    "Wedrix\\WatchtowerBundle\\WedrixWatchtowerBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "<info>Watchtower setup</info>",
                    "",
                    "  * For a new project, configure your Doctrine entities, then generate the schema:",
                    "    <comment>php bin/console watchtower:schema:generate</comment>",
                    "",
                    "  * Optimization is disabled by default. Before enabling it in production, generate",
                    "    the production Watchtower cache and verify your application works with it:",
                    "    <comment>APP_ENV=prod APP_DEBUG=0 php bin/console watchtower:cache:generate</comment>",
                    "    Regenerate it after changing the schema, plugins, or scalar definitions.",
                    "    Core 10/11 may omit the plugin cache when no plugins exist; keep optimization",
                    "    disabled unless the generated cache has been verified.",
                    "",
                    "  * Existing configuration must use <comment>wedrix_watchtower_bundle:</comment> as its",
                    "    root key, including inside <comment>when@prod</comment>.",
                    "",
                    "  * When upgrading the Watchtower core, migrate custom plugins before deploying,",
                    "    including authorization plugin directories and namespaces for core 12.3:",
                    "    <comment>https://github.com/Wedrix/watchtower-symfony-bundle/blob/v4.0.0/docs/watchtower-12-compatibility.md</comment>"
                ]
            },
            "files": {
                "config/packages/wedrix_watchtower_bundle.yaml": {
                    "contents": [
                        "wedrix_watchtower_bundle:",
                        "    endpoint: '/graphql.json'",
                        "    schema_file: '%kernel.project_dir%/config/watchtower/schema.graphql'",
                        "    plugins_directory: '%kernel.project_dir%/config/watchtower/plugins'",
                        "    scalar_type_definitions_directory: '%kernel.project_dir%/config/watchtower/scalar_type_definitions'",
                        "    cache_directory: '%kernel.cache_dir%/watchtower'",
                        "    # Enable only after generating and validating the cache for your core version.",
                        "    optimize: false",
                        "    debug: '%kernel.debug%'",
                        "    context:",
                        "        # Register services here to access them in the context param.",
                        "        # The service key can be any name of your choosing but the value should be the service id.",
                        "        # For example: entity_manager: 'doctrine.orm.entity_manager'",
                        "        entity_manager: 'doctrine.orm.entity_manager'",
                        "",
                        "when@prod:",
                        "    wedrix_watchtower_bundle:",
                        "        debug: false",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/wedrix_watchtower_bundle_routes.yaml": {
                    "contents": [
                        "wedrix_watchtower_bundle_routes:",
                        "    resource: 'Wedrix\\WatchtowerBundle\\Service\\RoutesLoader'",
                        "    type: service",
                        "    controller: 'Wedrix\\WatchtowerBundle\\Controller\\WatchtowerController'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "9f1d6024dee3fc940142ae809a620deeb79ebd8d"
        }
    }
}
