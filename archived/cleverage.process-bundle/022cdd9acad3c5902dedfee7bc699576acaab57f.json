{
    "manifests": {
        "cleverage/process-bundle": {
            "manifest": {
                "bundles": {
                    "CleverAge\\ProcessBundle\\CleverAgeProcessBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * Define your processes in <comment>config/packages/process/</>, one file per process",
                    "  * List them with <comment>php bin/console cleverage:process:list</>",
                    "  * Run one with <comment>php bin/console cleverage:process:execute <process_code></>",
                    "",
                    "  * Read the documentation at <comment>https://github.com/cleverage/process-bundle/blob/main/docs/index.md</>"
                ]
            },
            "files": {
                "config/packages/clever_age_process.yaml": {
                    "contents": [
                        "# Each file of config/packages/process/ defines one or more processes",
                        "imports:",
                        "    - { resource: process/ }",
                        "",
                        "clever_age_process:",
                        "    # Behavior of a task that encounters an error without its own \"error_strategy\": stop or skip",
                        "    default_error_strategy: stop",
                        "",
                        "    # Reusable transformers, referenced by their name in the processes",
                        "    # See https://github.com/cleverage/process-bundle/blob/main/docs/reference/03-generic_transformers_definition.md",
                        "    # generic_transformers:",
                        "    #     uppercase:",
                        "    #         transformers:",
                        "    #             callback:",
                        "    #                 callback: strtoupper",
                        ""
                    ],
                    "executable": false
                },
                "config/packages/process/.gitignore": {
                    "contents": [
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "022cdd9acad3c5902dedfee7bc699576acaab57f"
        }
    }
}
